# KIVerdienst v2 Environment Configuration
# Copy this file to .env and update with your actual values
# DO NOT commit .env to version control

# PostgreSQL Configuration
POSTGRES_USER=kiverdienst
POSTGRES_PASSWORD=CHANGE_ME_secure_random_password_here_min_32_chars
POSTGRES_DB=kiverdienst_v2
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database URL for application
DATABASE_URL=postgresql://kiverdienst:CHANGE_ME_secure_random_password_here_min_32_chars@postgres:5432/kiverdienst_v2

# Ollama Configuration
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL_PRIMARY=llama3.1:70b
OLLAMA_MODEL_SECONDARY=llama3.1:8b

# FastAPI Configuration
API_PORT=8000
SECRET_KEY=CHANGE_ME_generate_random_secret_key_min_64_chars_hexadecimal
JWT_SECRET_KEY=CHANGE_ME_another_random_secret_for_jwt_tokens
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Application Settings
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:80

# File Upload Settings
MAX_UPLOAD_SIZE_MB=100
MEDIA_ROOT=/app/media
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp,gif
ALLOWED_VIDEO_TYPES=mp4,mov,avi,webm

# External API Keys (if needed)
RUNWAY_API_KEY=
GUMROAD_API_KEY=
TIKTOK_API_KEY=
INSTAGRAM_API_KEY=

# Security Settings
BCRYPT_ROUNDS=12
SESSION_TIMEOUT_MINUTES=60
MAX_LOGIN_ATTEMPTS=5
RATE_LIMIT_PER_MINUTE=100

# Email Configuration (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@kiverdienst.com
SMTP_USE_TLS=true

# Monitoring & Analytics
SENTRY_DSN=
ANALYTICS_ENABLED=false

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# ============================================
# INSTRUCTIONS FOR GENERATING SECURE VALUES:
# ============================================
#
# Generate POSTGRES_PASSWORD:
#   openssl rand -base64 48
#
# Generate SECRET_KEY:
#   openssl rand -hex 64
#
# Generate JWT_SECRET_KEY:
#   openssl rand -hex 64
#
# After generating, copy this file to .env:
#   cp .env.template .env
#
# Then edit .env with your actual values:
#   nano .env
#
# ============================================
