# KIVerdienst v2 Environment Configuration
# Copy this file to .env and update with your values

# Database Configuration
POSTGRES_USER=kiverdienst
POSTGRES_PASSWORD=secure123kiverdienst
POSTGRES_DB=kiverdienst_v2

# Backend Configuration
BACKEND_PORT=8000
SECRET_KEY=your-secret-key-here-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here

# Frontend Configuration
FRONTEND_PORT=5000

# System Configuration
DEBUG=false
LOG_LEVEL=INFO

# Optional: Ollama Configuration (for AI features)
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama2

# Optional: ElevenLabs API (for voice generation)
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Optional: Social Media API Keys
TIKTOK_API_KEY=your-tiktok-api-key
INSTAGRAM_API_KEY=your-instagram-api-key
YOUTUBE_API_KEY=your-youtube-api-key
