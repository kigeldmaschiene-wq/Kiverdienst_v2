# KIVerdienst v2 Environment Configuration
# Copy this file to .env and update the values

# ===== Database Configuration =====
POSTGRES_USER=kiverdienst
POSTGRES_PASSWORD=secure123kiverdienst
POSTGRES_DB=kiverdienst_v2
POSTGRES_PORT=5432

# Full database URL (constructed from above)
DATABASE_URL=postgresql://kiverdienst:secure123kiverdienst@postgres:5432/kiverdienst_v2

# ===== Backend Configuration =====
BACKEND_PORT=8000
SECRET_KEY=your-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-change-this

# ===== Frontend Configuration =====
FRONTEND_PORT=5000
BACKEND_URL=http://backend:8000

# ===== Application Settings =====
DEBUG=false
LOG_LEVEL=INFO
SQL_ECHO=false

# ===== Optional Services =====
# Ollama LLM (for AI content generation)
OLLAMA_URL=http://ollama:11434
DEFAULT_MODEL=llama2

# ElevenLabs (for voice synthesis)
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# ===== Security =====
# Change these in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-random-secret-key
JWT_SECRET_KEY=change-this-to-another-random-key
